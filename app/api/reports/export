// =============================================================
// GET /api/reports/export
// =============================================================
// Streams a CSV of every individual job matching the current
// filters. One row per job, helper name repeated on each row.
// This is the flat expanded format Shannon uses for spot checks.
//
// Query params: same as /api/reports (from, to, basis,
//   statuses, kinds, territories, helpers, types)
// =============================================================

import { NextRequest, NextResponse } from 'next/server'
import { isAdmin } from '@/lib/auth'
import { getServiceSupabase } from '@/lib/supabase'
import { computeJobPay, payScaleForAddress, JobKind } from '@/lib/pay'
export const dynamic = 'force-dynamic'

type DateBasis = 'event_date' | 'setup_date' | 'created_at' | 'updated_at'
const VALID_BASIS: DateBasis[] = ['event_date', 'setup_date', 'created_at', 'updated_at']

function parseCsv(v: string | null): string[] {
  if (!v) return []
  return v.split(',').map(s => s.trim()).filter(Boolean)
}
function parseIntCsv(v: string | null): number[] {
  return parseCsv(v).map(s => parseInt(s, 10)).filter(n => !isNaN(n))
}
function esc(v: any): string {
  if (v == null) return ''
  const s = String(v)
  if (s.includes(',') || s.includes('"') || s.includes('\n')) {
    return `"${s.replace(/"/g, '""')}"`
  }
  return s
}

export async function GET(req: NextRequest) {
  if (!isAdmin(req)) {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
  }

  const db = getServiceSupabase()
  const { searchParams } = new URL(req.url)

  const from      = searchParams.get('from')
  const to        = searchParams.get('to')
  const basisRaw  = (searchParams.get('basis') || 'event_date') as DateBasis
  const basis     = VALID_BASIS.includes(basisRaw) ? basisRaw : 'event_date'

  const territories = parseCsv(searchParams.get('territories'))
  const helperIds   = parseIntCsv(searchParams.get('helpers'))
  const statuses    = parseCsv(searchParams.get('statuses')).length > 0
    ? parseCsv(searchParams.get('statuses'))
    : ['complete']
  const kinds       = parseCsv(searchParams.get('kinds')).length > 0
    ? parseCsv(searchParams.get('kinds'))
    : ['drop', 'pick']
  const types       = parseCsv(searchParams.get('types'))

  // ── FETCH HELPERS ─────────────────────────────────────────
  const { data: helpers } = await db
    .from('helpers')
    .select('id, name, email, territory, pay_override')

  const helpersById = new Map<number, any>()
  ;(helpers || []).forEach(h => helpersById.set(h.id, h))

  // ── BUILD JOBS QUERY ─────────────────────────────────────
  let q = db.from('jobs').select('*')
  if (from)               q = q.gte(basis, from)
  if (to)                 q = q.lte(basis, to)
  if (statuses.length)    q = q.in('status', statuses)
  if (kinds.length)       q = q.in('kind', kinds)
  if (territories.length) q = q.in('territory', territories)
  if (types.length)       q = q.in('type', types)
  if (helperIds.length)   q = q.in('helper_id', helperIds)

  const { data: jobs, error } = await q.order('event_date', { ascending: true })
  if (error) {
    return NextResponse.json({ error: error.message }, { status: 500 })
  }

  // ── ENRICH + BUILD CSV ────────────────────────────────────
  const COLUMNS = [
    'Job ID', 'Order Number', 'Customer', 'Address', 'Territory',
    'Type', 'Kind', 'Status', 'Event Date', 'Setup Date',
    'Helper Name', 'Helper Email', 'Helper Territory',
    'Pay Scale', 'Earnings ($)',
    'Created At', 'Updated At', 'Notes',
  ]

  const rows: string[] = [COLUMNS.map(esc).join(',')]

  for (const j of jobs || []) {
    const helper = j.helper_id ? helpersById.get(j.helper_id) : null
    const pay = computeJobPay(j.address, j.kind as JobKind, helper?.pay_override)
    const scale = payScaleForAddress(j.address)

    rows.push([
      j.id,
      j.order_number   ?? '',
      j.customer_name  ?? '',
      j.address        ?? '',
      j.territory      ?? '',
      j.type           ?? '',
      j.kind           ?? '',
      j.status         ?? '',
      j.event_date     ?? '',
      j.setup_date     ?? '',
      helper?.name     ?? '',
      helper?.email    ?? '',
      helper?.territory ?? '',
      scale,
      pay.toFixed(2),
      j.created_at     ?? '',
      j.updated_at     ?? '',
      j.notes          ?? '',
    ].map(esc).join(','))
  }

  const csv = rows.join('\r\n')
  const filename = `cmy-jobs-export-${new Date().toISOString().slice(0,10)}.csv`

  return new NextResponse(csv, {
    status: 200,
    headers: {
      'Content-Type': 'text/csv; charset=utf-8',
      'Content-Disposition': `attachment; filename="${filename}"`,
    },
  })
}

